# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Web Push server base URL (baobaobaiwebpushserver)
VITE_PUSH_SERVER_BASE_URL="http://localhost:8787"

# Online theme market source base URL.
# Used for production builds (.env.production) and single-file HTML builds (.env.singlefile).
# Override locally in .env.local for development.
VITE_ONLINE_THEME_SOURCE_BASE_URL="http://127.0.0.1:8080"

# Online widget market source base URL (baobaobaivault share public endpoint).
VITE_ONLINE_WIDGET_SOURCE_BASE_URL="http://127.0.0.1:8080"

# Online WeChat theme market source base URL (baobaobaivault share public endpoint).
VITE_ONLINE_WECHAT_THEME_SOURCE_BASE_URL="http://127.0.0.1:8080"

# Online world book market source base URL (baobaobaivault share public endpoint).
VITE_ONLINE_WORLDBOOK_SOURCE_BASE_URL="http://127.0.0.1:8080"
# Online character persona market source base URL (baobaobaivault share public endpoint).
VITE_ONLINE_CHARACTER_PERSONA_SOURCE_BASE_URL="http://127.0.0.1:8080"
